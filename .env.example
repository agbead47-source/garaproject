# 포장재 가격 동향에서 쓰는 API 키.
# 이 파일은 이름과 설명만 담습니다. 실제 키는 `.env` 에 넣고, `.env` 는 Git 에 올리지 않습니다.
#
#   cp .env.example .env     # 복사한 뒤 값을 채우세요

# 미국 노동통계국(BLS) 공개 API - 선택 사항
#   없어도 동작합니다. 미등록 한도(v1)로 붙습니다.
#   키를 넣으면 v2 로 붙어 하루 한도가 늘고 계열 이름(catalog)까지 받아 옵니다.
#   발급: https://www.bls.gov/developers/  (무료)
BLS_API_KEY=

# Metals.Dev - 알루미늄 시세 조회용 (필수, 없으면 알루미늄 카드가 "API 키 설정 필요")
#   무료 플랜 월 100회. 이 프로젝트는 하루 2회만 받고 재시도까지 한도에 넣습니다.
#   발급: https://metals.dev/  (무료 플랜, 신용카드 불필요)
METALS_DEV_API_KEY=

# 아마존 화장품 순위 수집 (선택, 기본 꺼짐)
#   robots.txt 는 베스트셀러 경로를 막지 않지만, 아마존 이용약관은 자동 수집을
#   제한합니다. 공식 경로는 Product Advertising API 입니다.
#   켤지 여부는 담당자가 판단하시라고 기본을 꺼 뒀습니다.
#   켜면 하루 1회, 카테고리 4개를 3초 간격으로 받아 옵니다.
#   1 / true / yes / on 중 하나를 넣으면 켜집니다.
AMAZON_RANK_ENABLED=0

# 한국수출입은행 고시환율 (선택)
#   영업단가 계산의 견적환율을 실무에서 쓰는 매매기준율로 받아 옵니다.
#   없어도 동작합니다. 키가 없으면 ECB 참고환율(키 불필요)만 고를 수 있습니다.
#   발급: https://www.koreaexim.go.kr/ir/HPHKIR019M01  (무료, 하루 1,000회)
#   이 프로젝트는 하루 300회까지만 씁니다.
KOREAEXIM_API_KEY=
